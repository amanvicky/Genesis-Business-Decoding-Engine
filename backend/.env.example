# Genesis backend configuration (all optional — sane defaults built in)

# Skip all live network scraping and run on built-in knowledge bases only.
# Useful for offline use, CI, and debugging.
GENESIS_OFFLINE=0

# Optional free local LLM (Ollama) used to sharpen section narratives.
# If Ollama is not running, Genesis falls back to deterministic analysis.
OLLAMA_URL=http://127.0.0.1:11434
GENESIS_LLM_MODEL=llama3.2

# Tor SOCKS5 proxy for the Deep/Dark Web OSINT module (Tab 11).
# Start Tor with: tor --SocksPort 9050
TOR_PROXY=socks5://127.0.0.1:9050
TOR_ENABLED=1

# Outbound HTTP timeout in seconds
REQUEST_TIMEOUT=25
